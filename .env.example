# ===========================================
# CONFIGURACION DE ENTORNO - DISTRIBUIDORA APP
# ===========================================
# Copia este archivo como .env y completa con tus credenciales
# NUNCA commitees el archivo .env con valores reales

# Supabase - URL de tu proyecto (Settings > API en Supabase Dashboard)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Supabase - Clave anonima publica (anon key) (Settings > API en Supabase Dashboard)
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Google Maps API Key. Va SI O SI en el cliente: el SDK de Maps se carga con
# <script src="maps.googleapis.com/...?key=">, asi que la key es publica por
# diseno. Se protege con restricciones de referrer HTTP en Google Cloud Console,
# no ocultandola. La usa el autocompletado de direcciones y el geocoding inverso.
# La optimizacion de rutas NO la usa: eso va por la Edge Function optimizar-ruta,
# que tiene su propia key como secret del servidor.
VITE_GOOGLE_API_KEY=tu-google-api-key-aqui

# El escaneo de facturas y la optimizacion de rutas ya no van por n8n: usan
# las Edge Functions escanear-factura y optimizar-ruta, con sus keys como
# secrets del servidor. No hay variable VITE_ para ninguna de las dos.

# ===========================================
# BOT TELEGRAM (solo en backend / Supabase Edge Functions)
# ===========================================
# Estas variables se setean en el dashboard de Supabase Edge Functions
# (Settings > Edge Functions > Secrets), NO en el frontend.
# Listadas aquí solo como referencia de qué necesita el bot para funcionar.
# Ver: supabase/functions/README.md
# TELEGRAM_BOT_TOKEN=          # Token del BotFather
# TELEGRAM_WEBHOOK_SECRET=     # String random, único, validado en cada request
# GEMINI_API_KEY=              # Google AI Studio key (https://aistudio.google.com/apikey)
# GEMINI_MODEL=gemini-2.5-flash  # opcional, default gemini-2.5-flash
# BOT_MAX_TOOL_ITERATIONS=5    # opcional, max chains de tool calls (1-20)

# Username del bot a mostrar en el modal de vinculación del frontend.
# A diferencia de las dos de arriba, ESTA SÍ es del frontend (no es secreto,
# es solo el handle público del bot). Setear cuando BotFather lo cree.
# VITE_TELEGRAM_BOT_USERNAME=@nombre_de_tu_bot   # ej: @distribuidora_ai_bot

# ===========================================
# OPTIMIZAR-RUTA (Edge Function)
# ===========================================
# Origen exacto del front (con protocolo, sin trailing slash), para
# Access-Control-Allow-Origin. Sin setear, la función cae a "*".
# APP_ORIGIN=https://app.tudistribuidora.com

# ===========================================
# MONITOREO Y ERRORES
# ===========================================

# Sentry DSN para monitoreo de errores en produccion
# Obtener en: https://sentry.io > Settings > Client Keys (DSN)
VITE_SENTRY_DSN=

# Version de la aplicacion (para releases en Sentry)
VITE_APP_VERSION=1.0.0
